# ═══════════════════════════════════════════════════════════════════════════════
#  HR Attendance & Payroll Engine – .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tgz
package-lock.json.bak

# ── TypeScript / Build Artifacts ──────────────────────────────────────────────
dist/
build/
*.js.map
*.d.ts.map
tsconfig.tsbuildinfo

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
.vercel/

# ── Prisma ────────────────────────────────────────────────────────────────────
# Prisma lives under backend/prisma. schema, seed, and migrations are all
# committed (migrations must be committed so `prisma migrate deploy` runs in
# CI/production); the generated client under node_modules stays ignored.

# ── Test & Coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
jest-results.json
*.lcov

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.editorconfig.local

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temp / Local ──────────────────────────────────────────────────────────────
*.local
tmp/
temp/
