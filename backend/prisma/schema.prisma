generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id               Int       @id @default(autoincrement())
  employeeCode     String    @unique
  email            String?   @unique
  firstName        String
  lastName         String
  departmentId     Int
  shiftId          Int
  baseSalary       Float     @default(0)
  dailyRate        Float     @default(0)
  isActive         Boolean   @default(true)
  hireDate         DateTime
  terminationDate  DateTime?
  department       Department @relation(fields: [departmentId], references: [id])
  shift            Shift      @relation(fields: [shiftId], references: [id])
  attendances      AttendanceResult[]
  attendanceRaws   AttendanceRaw[]
  payrollItems     PayrollItem[]
  leaves           Leave[]
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String
  managerId   Int?
  employees   Employee[]
}

model Shift {
  id                Int    @id @default(autoincrement())
  name              String
  startTime         String // HH:mm
  endTime           String // HH:mm
  lunchBreakMinutes Int
  overnight         Boolean
  employees         Employee[]
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique
  description String
  isPublic    Boolean
}

model Leave {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  type        String
  approvedBy  Int?
}

model AttendanceRaw {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id])
  clockIn       DateTime?
  clockOut      DateTime?
  date          DateTime
  sourceFile    String?
  importLogId   Int
  importLog     ImportLog @relation(fields: [importLogId], references: [id])
}

model AttendanceResult {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  employee         Employee @relation(fields: [employeeId], references: [id])
  date             DateTime
  workingSeconds   Int
  lateSeconds      Int
  earlyOutSeconds  Int
  otSeconds        Int
  isAbsent         Boolean
  missingClock     Boolean
  mealAllowance    Float    @default(0)
  ruleVersionId    Int?
  ruleVersion      RuleVersion? @relation(fields: [ruleVersionId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([employeeId, date])
}

model PayrollBatch {
  id          Int       @id @default(autoincrement())
  periodStart DateTime
  periodEnd   DateTime
  status      String
  createdById Int?
  itemCount   Int       @default(0)
  totalGross  Float     @default(0)
  totalNet    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?
  items       PayrollItem[]

  @@unique([periodStart, periodEnd])
}

model PayrollItem {
  id                       Int          @id @default(autoincrement())
  batchId                  Int
  batch                    PayrollBatch @relation(fields: [batchId], references: [id])
  employeeId               Int
  employee                 Employee     @relation(fields: [employeeId], references: [id])
  baseSalary               Float
  totalWorkingSeconds      Int          @default(0)
  totalOtSeconds           Int          @default(0)
  totalMealAllowance       Float        @default(0)
  diligenceAmount          Float        @default(0)
  otPay                    Float        @default(0)
  grossPay                 Float        @default(0)
  socialSecurityDeduction  Float        @default(0)
  incomeTaxDeduction       Float        @default(0)
  totalDeductions          Float        @default(0)
  netPay                   Float        @default(0)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([batchId, employeeId])
}

model ImportLog {
  id           Int      @id @default(autoincrement())
  fileName     String
  fileSize     Int?
  uploadedById Int?
  status       String
  totalRows    Int      @default(0)
  validRows    Int      @default(0)
  errorRows    Int      @default(0)
  errorReport  Json?
  uploadedAt   DateTime @default(now())
  processedAt  DateTime?
  updatedAt    DateTime @updatedAt
  rawRecords   AttendanceRaw[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tableName String
  recordId  Int
  operation String
  changedBy Int
  oldValue  Json?
  newValue  Json?
  reason    String?
  timestamp DateTime @default(now())
}

model RuleCategory {
  id          Int @id @default(autoincrement())
  name        String @unique
  definitions RuleDefinition[]
}

model RuleDefinition {
  id               Int @id @default(autoincrement())
  categoryId       Int
  category         RuleCategory @relation(fields: [categoryId], references: [id])
  name             String
  code             String?
  description      String?
  formulaTemplate  String?
  effectiveDate    DateTime
  expiryDate       DateTime?
  versions         RuleVersion[]
}

model RuleVersion {
  id            Int @id @default(autoincrement())
  definitionId  Int
  definition    RuleDefinition @relation(fields: [definitionId], references: [id])
  versionNumber Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean @default(true)
  value         Json?
  values        RuleValue[]
  attendanceResults AttendanceResult[]
}

model RuleValue {
  id            Int @id @default(autoincrement())
  ruleVersionId Int
  ruleVersion   RuleVersion @relation(fields: [ruleVersionId], references: [id])
  key           String
  value         String
  valueType     String
}

model CompanySetting {
  key   String @id
  value String
}
