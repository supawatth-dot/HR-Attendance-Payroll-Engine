# ═══════════════════════════════════════════════════════════════════════════════
#  HR Attendance & Payroll Engine – Environment Variables
#  Copy this file to .env and fill in all values before running the application.
#  NEVER commit the actual .env file to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────

# Full PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/hr_payroll?schema=public

# ── Authentication ────────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens. Use a strong random string (≥ 64 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# How long access tokens remain valid. Examples: 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# ── Redis / Queue ─────────────────────────────────────────────────────────────

# Redis connection URL used by BullMQ for job queues.
# Format: redis://<host>:<port>
REDIS_URL=redis://localhost:6379

# ── Backend Server ────────────────────────────────────────────────────────────

# TCP port the NestJS backend listens on.
PORT=3000

# ── Frontend Server ───────────────────────────────────────────────────────────

# TCP port the Next.js frontend listens on.
FRONTEND_PORT=3001

# Public URL of the backend API consumed by the Next.js frontend.
# In production replace localhost with your domain or load-balancer address.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── PostgreSQL (Docker Compose) ───────────────────────────────────────────────
# These variables are used by the postgres service in docker-compose.yml.
# They must match the credentials embedded in DATABASE_URL above.

# Password for the PostgreSQL superuser.
POSTGRES_PASSWORD=changeme

# PostgreSQL username (default: postgres).
POSTGRES_USER=postgres

# Name of the application database.
POSTGRES_DB=hr_payroll
